#!/bin/sh
#
# Blocks commits that would publish credentials to this public repository.
#
# Two checks run against staged content:
#   1. Filenames that hold local credentials or runtime state, caught even when
#      `git add -f` was used to bypass .gitignore.
#   2. Added lines matching a known secret format.
#
# A line ending in `pragma: allowlist secret` is skipped by the content check.
# Deliberate override for one commit: git commit --no-verify

set -u

TAB=$(printf '\t')

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$staged" ] || exit 0

# ---------------------------------------------------------------- filenames --
blocked=$(printf '%s\n' "$staged" | while IFS= read -r file; do
  [ -n "$file" ] || continue
  case "$file" in
    anyapi-key.txt|*/anyapi-key.txt) ;;
    .env|.env.*|*/.env|*/.env.*) ;;
    *.pem|*.pfx|*.p12|*.key|*.keystore|*.jks) ;;
    id_rsa|id_dsa|id_ecdsa|id_ed25519|*/id_rsa|*/id_dsa|*/id_ecdsa|*/id_ed25519) ;;
    .npmrc|*/.npmrc|.netrc|*/.netrc) ;;
    seen-posts.json|*/seen-posts.json) ;;
    signal-debug.log|*/signal-debug.log|log.txt|*/log.txt) ;;
    anyapi-last-response-*.json|*/anyapi-last-response-*.json) ;;
    diagnostic-fixtures/*|*/diagnostic-fixtures/*) ;;
    *) continue ;;
  esac
  printf '%s\n' "$file"
done)

# ----------------------------------------------------------------- contents --
# Only precise, prefixed formats. Generic high-entropy rules false-positive
# against the base64 integrity hashes in package-lock.json.
patterns='-----BEGIN [A-Z ]*PRIVATE KEY-----
sk-[A-Za-z0-9_-]{20,}
gh[pousr]_[A-Za-z0-9]{30,}
github_pat_[A-Za-z0-9_]{30,}
(AKIA|ASIA)[0-9A-Z]{16}
AIza[0-9A-Za-z_-]{35}
xox[baprs]-[A-Za-z0-9-]{12,}
eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}
Bearer [A-Za-z0-9_.=-]{20,}
://[^/:@[:space:]]+:[^/@[:space:]]+@
(ANYAPI_KEY|API_KEY|APIKEY|SECRET|TOKEN|PASSWORD)[[:space:]]*=[[:space:]]*.?[A-Za-z0-9_./+-]{16,}'

# Added lines only, each tagged with its file as "path<TAB>content".
added=$(git diff --cached -U0 --diff-filter=ACM \
  | awk '/^\+\+\+ /{f=substr($0,7); next} /^\+/{print f "\t" substr($0,2)}' \
  | grep -v 'pragma: allowlist secret')

hits=''
if [ -n "$added" ]; then
  hits=$(printf '%s\n' "$patterns" | while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    printf '%s\n' "$added" | grep -E -- "$pattern" | while IFS="$TAB" read -r file content; do
      match=$(printf '%s' "$content" | grep -Eo -- "$pattern" | head -1)
      printf '%s\t%s\n' "$file" "$match"
    done
  done)
fi

[ -n "$blocked" ] || [ -n "$hits" ] || exit 0

# -------------------------------------------------------------------- report --
if [ -t 2 ]; then
  printf '\033[1;31mpre-commit: refusing to commit — possible secrets staged.\033[0m\n\n' >&2
else
  printf 'pre-commit: refusing to commit - possible secrets staged.\n\n' >&2
fi

if [ -n "$blocked" ]; then
  printf '%s\n' "$blocked" | while IFS= read -r file; do
    printf '  %s\n      credential or runtime file, must stay untracked\n' "$file" >&2
  done
fi

if [ -n "$hits" ]; then
  # Show a short prefix only; never echo a full credential into the terminal.
  printf '%s\n' "$hits" | sort -u | while IFS="$TAB" read -r file match; do
    printf '  %s\n      matches a secret format: %.10s...\n' "$file" "$match" >&2
  done
fi

printf '\nUnstage the offending content, or append "pragma: allowlist secret"\n' >&2
printf 'to a line that is a genuine false positive.\n' >&2
printf 'Deliberate override: git commit --no-verify\n' >&2
exit 1
